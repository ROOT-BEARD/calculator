<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">


    <TextView
        android:id="@+id/solution_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="0"
        android:textSize="32dp"
        android:textAlignment="textEnd"
        app:layout_constraintBottom_toTopOf="@id/resault_tv"
        />

    <TextView
        android:id="@+id/resault_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="0"
        android:textSize="64dp"
        android:textAlignment="textEnd"
        app:layout_constraintBottom_toTopOf="@id/button_layout"
        />

    <LinearLayout
        android:id="@+id/button_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_c"
                android:layout_height="72dp"
                android:layout_width="72dp"
                android:layout_margin="12dp"
                android:text="C"
                android:textSize="32dp"
                />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_open_bracket"
                android:layout_height="72dp"
                android:layout_width="72dp"
                android:layout_margin="12dp"
                android:text="("
                android:textSize="32dp"
                />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_close_bracket"
                android:layout_height="72dp"
                android:layout_width="72dp"
                android:layout_margin="12dp"
                android:text=")"
                android:textSize="32dp"
                />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_divide"
                android:layout_height="72dp"
                android:layout_width="72dp"
                android:layout_margin="12dp"
                android:text="/"
                android:textSize="32dp"
                />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">


            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_7"
                android:layout_height="72dp"
                android:layout_width="72dp"
                android:layout_margin="12dp"
                android:text="7"
                android:textSize="32dp"
                />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_8"
                android:layout_height="72dp"
                android:layout_width="72dp"
                android:layout_margin="12dp"
                android:text="8"
                android:textSize="32dp"
                />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_9"
                android:layout_height="72dp"
                android:layout_width="72dp"
                android:layout_margin="12dp"
                android:text="9"
                android:textSize="32dp"
                />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_mul"
                android:layout_height="72dp"
                android:layout_width="72dp"
                android:layout_margin="12dp"
                android:text="*"
                android:textSize="32dp"
                />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">


            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_4"
                android:layout_height="72dp"
                android:layout_width="72dp"
                android:layout_margin="12dp"
                android:text="4"
                android:textSize="32dp"
                />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_5"
                android:layout_height="72dp"
                android:layout_width="72dp"
                android:layout_margin="12dp"
                android:text="5"
                android:textSize="32dp"
                />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_6"
                android:layout_height="72dp"
                android:layout_width="72dp"
                android:layout_margin="12dp"
                android:text="6"
                android:textSize="32dp"
                />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_plus"
                android:layout_height="72dp"
                android:layout_width="72dp"
                android:layout_margin="12dp"
                android:text="+"
                android:textSize="32dp"
                />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">


            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_1"
                android:layout_height="72dp"
                android:layout_width="72dp"
                android:layout_margin="12dp"
                android:text="1"
                android:textSize="32dp"
                />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_2"
                android:layout_height="72dp"
                android:layout_width="72dp"
                android:layout_margin="12dp"
                android:text="2"
                android:textSize="32dp"
                />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_3"
                android:layout_height="72dp"
                android:layout_width="72dp"
                android:layout_margin="12dp"
                android:text="3"
                android:textSize="32dp"
                />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_min"
                android:layout_height="72dp"
                android:layout_width="72dp"
                android:layout_margin="12dp"
                android:text="-"
                android:textSize="32dp"
                />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">


            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_ac"
                android:layout_height="72dp"
                android:layout_width="72dp"
                android:layout_margin="12dp"
                android:text="AC"
                android:textSize="18dp"
                />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_0"
                android:layout_height="72dp"
                android:layout_width="72dp"
                android:layout_margin="12dp"
                android:text="0"
                android:textSize="32dp"
                />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_dot"
                android:layout_height="72dp"
                android:layout_width="72dp"
                android:layout_margin="12dp"
                android:text="."
                android:textSize="32dp"
                />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_eq"
                android:layout_height="72dp"
                android:layout_width="72dp"
                android:layout_margin="12dp"
                android:text="="
                android:textSize="32dp"
                />
        </LinearLayout>


    </LinearLayout>







</androidx.constraintlayout.widget.ConstraintLayout>